{
  "name": "problem-4",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Express + TypeScript service scaffold",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "NODE_ENV=local tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "NODE_ENV=test mocha 'test/**/*.spec.ts'",
    "test:unit": "NODE_ENV=test mocha 'test/unit/**/*.spec.ts'",
    "test:integration": "NODE_ENV=test mocha 'test/integration/**/*.spec.ts'",
    "test:watch": "NODE_ENV=test mocha --watch --watch-files 'src/**/*.ts,test/**/*.ts' 'test/**/*.spec.ts'",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "openapi:html": "NODE_ENV=local tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.19.3",
    "server-health": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "chai": "^4.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
